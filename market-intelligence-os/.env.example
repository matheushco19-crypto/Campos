# ── Market Intelligence OS ─────────────────────────────────────────────
# Copy to .env.local (never commit real values). Only server-side code reads these.

# Storage: "file" (local JSON in MI_DATA_DIR), "supabase" (production) or "memory" (tests).
# If unset: supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY exist, otherwise file.
MI_STORAGE=file
MI_DATA_DIR=data

# Supabase (dedicated project "market-intelligence-os"). Service role key: server only.
SUPABASE_URL=https://hourclrikooygkrinjoc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM for Agent 2/3 interpretation:
#   claude_code   → hand-off to a Claude Code routine (Claude Pro/Max, no API key)  [default without key]
#   anthropic_api → Claude API (requires ANTHROPIC_API_KEY)                         [default with key]
#   deterministic → facts-only brief, no LLM
MI_LLM_PROVIDER=claude_code
ANTHROPIC_API_KEY=
MI_MODEL_DEEP=claude-opus-5-5
MI_MODEL_FAST=claude-haiku-4-5

# Security
CRON_SECRET=            # Vercel Cron sends "Authorization: Bearer $CRON_SECRET"; also used by the Claude Code routine
DASHBOARD_PASSWORD=     # HTTP Basic Auth for the dashboard (any username)

# Optional data sources (each unlocks verification for more assets)
BRAPI_TOKEN=            # Ibovespa (B3) via brapi.dev REST — free plan covers ^BVSP (FX/crypto/Selic are paid there)
TWELVEDATA_API_KEY=     # free key: extra source for indices/DXY where the free plan covers them
FRED_API_KEY=           # FRED official API (otherwise public CSV)
COINGECKO_DEMO_KEY=     # CoinGecko free demo key (403 without key from datacenters)
BOK_ECOS_KEY=           # Bank of Korea ECOS free key (KOSPI); without it the public "sample" key is used
MI_ENABLE_STOOQ=false   # Stooq 403s datacenter IPs; set true only where it responds

# Verification policy: "true" makes official single-source macro data UNVERIFIED instead of VERIFIED/MEDIUM
MI_VERIFICATION_STRICT_MACRO=false
MI_LOG_LEVEL=info
